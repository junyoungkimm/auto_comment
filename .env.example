# 이 파일을 .env 로 복사해서 쓰세요. 전부 선택이며, 비워두면 기본값으로 동작합니다.

# --- AI (분석 · 댓글 초안) ---
# 없으면 데모 모드(규칙 기반)로 돌고 화면에 '데모 데이터'가 뜹니다. 데모 초안은 게시할 수 없습니다.
# https://aistudio.google.com/apikey  (무료 등급은 모델·프로젝트마다 하루 한도가 있습니다)
GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-3.5-flash
# 주 모델이 실패(과부하·한도 초과·사용 불가)하면 차례로 시도할 모델. 쉼표로 여러 개
AGENT_GEMINI_FALLBACK=gemini-2.5-flash,gemini-3.5-flash-lite
# 자막을 못 받으면 제미나이가 유튜브 영상을 직접 보고 분석
AGENT_GEMINI_WATCH_VIDEO=true

# --- 영상 목록 ---
# 영상을 불러올 채널 (쉼표 구분). @핸들 또는 UC... 채널 ID. 유튜브 공식 RSS 라 키가 필요 없습니다
AGENT_CHANNELS=
# (선택) YouTube Data API 키. 없으면 계정1 의 OAuth 토큰으로 인기 댓글·키워드 검색을 합니다
YOUTUBE_API_KEY=

# --- 댓글 규칙 (코드에서 강제) ---
AGENT_BRAND=운명원
AGENT_MIN_CHARS=40
AGENT_MAX_CHARS=120
AGENT_DAILY_MAX_COMMENTS=10
# 광고 표기 강제 (표시광고법). false 로 끌 수 있습니다
AGENT_REQUIRE_DISCLOSURE=true

# --- 뜨기 직전 영상 기준 (가점) ---
AGENT_RISING_MIN_VIEWS=1000
AGENT_RISING_MAX_VIEWS=5000
AGENT_RISING_MIN_VPH=150

# --- 계정 (크롬 프로필) ---
# 각 프로필 폴더는 ./profiles/<이름> 에 만들어집니다
AGENT_PROFILES=계정1,계정2,계정3
# 크롬 실행 파일 경로 (비우면 자동 탐색)
AGENT_CHROME_PATH=
